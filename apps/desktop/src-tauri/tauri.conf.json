{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elo",
  "version": "0.1.0",
  "identifier": "app.elo.desktop",
  "build": {
    "beforeDevCommand": "node scripts/prepare-sidecars.mjs --debug && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare-sidecars.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Elo",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "rpm"],
    "externalBin": ["binaries/continuity-agent", "binaries/continuity"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Kalanguinnnn and Elo contributors",
    "publisher": "Elo",
    "shortDescription": "Continuidade de projetos Git entre computadores",
    "linux": { "deb": { "depends": ["git"] }, "rpm": { "depends": ["git"] } }
  }
}
